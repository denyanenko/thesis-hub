# Режим роботи середовища. Доступні варіанти: development, production, test
NODE_ENV=development
PORT=3000
DATABASE_URL="postgres://користувач:пароль@localhost:5432/thesis_db"
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET="ваш_секрет_для_access"
# Окремий довгий секрет для відновлення пароля (відмінний від access-секрету)
JWT_RESET_SECRET="ваш_окремий_секрет_для_reset"
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
# SMTP. Для Gmail потрібен "пароль застосунку" (App Password), а не звичайний пароль
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER="ваш_email@gmail.com"
SMTP_PASS="пароль_застосунку"
MAIL_FROM="Thesis Hub <ваш_email@gmail.com>"
INITIAL_ADMIN_EMAIL="email_адміна"
INITIAL_ADMIN_PASSWORD="пароль_адміна"
INITIAL_ADMIN_FIRST_NAME=Ім'я_Адміна
INITIAL_ADMIN_LAST_NAME=Прізвище_Адміна
